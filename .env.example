# ════════════════════════════════════════════════════════════════
#  MatchAI for Everyone — Environment Variables
#  Copy this file to .env and fill in your keys.
# ════════════════════════════════════════════════════════════════


# ── REQUIRED ─────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Resend API (recommended for cloud — HTTPS, works on Render)
# Sign up free at https://resend.com → copy your API key
# If set, this is used instead of Gmail SMTP
RESEND_API_KEY=

# Gmail SMTP (local dev fallback — only used if RESEND_API_KEY is not set)
# Requires a Gmail App Password (not your regular password):
# myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL=
EMAIL_PASSWORD=


# ── JOB SOURCES (all free, registration required) ────────────────

# Adzuna — https://developer.adzuna.com  (click "Register" → free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (US Federal Government jobs) — https://developer.usajobs.gov
# Register, then use your registered email as USAJOBS_EMAIL
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Jooble (large global aggregator, all job types) — https://jooble.org/api/about
# Click "Get API key" — fill out a short form, key arrives by email
JOOBLE_API_KEY=

# FindWork (tech & engineering jobs) — https://findwork.dev
# Sign up → go to your Profile page → copy the API token
FINDWORK_API_KEY=
# python app.py