# ════════════════════════════════════════════════════════════════
#  MatchAI for Everyone — Environment Variables
#  Copy this file to .env and fill in your keys.
# ════════════════════════════════════════════════════════════════


# ── REQUIRED ─────────────────────────────────────────────────────
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gmail sender account (use an App Password, not your real password)
# How to get App Password: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL=
EMAIL_PASSWORD=


# ── JOB SOURCES (all free, registration required) ────────────────

# Adzuna — https://developer.adzuna.com  (click "Register" → free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs (US Federal Government jobs) — https://developer.usajobs.gov
# Register, then use your registered email as USAJOBS_EMAIL
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Jooble (large global aggregator, all job types) — https://jooble.org/api/about
# Click "Get API key" — fill out a short form, key arrives by email
JOOBLE_API_KEY=

# FindWork (tech & engineering jobs) — https://findwork.dev
# Sign up → go to your Profile page → copy the API token
FINDWORK_API_KEY=
